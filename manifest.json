{
  "manifest_version": 3,
  "name": "Grok Usage Tracker",
  "version": "1.0.0",
  "description": "Shows Grok usage inline next to the model selector",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Grok Usage Tracker"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://grok.com/*"],
      "js": ["src/data.js", "src/render.js", "src/content.js"],
      "run_at": "document_end"
    }
  ],
  "host_permissions": ["https://grok.com/*"],
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}